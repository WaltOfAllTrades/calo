    "calc.settings.experiments": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiments"
          }
        }
      }
    },
    "calc.about.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A free construction calculator. No ads, no subscription, no account, nothing locked. It works with no signal. Your numbers stay on your phone."
          }
        }
      }
    },
    "calc.help.key.feet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks feet. Type the way you read the tape: 5 ′ 3 ″ 1 ⁄ 2 is 5 feet 3½ inches."
          }
        }
      }
    },
    "calc.help.key.inches": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks inches, and separates them from a fraction: 5 ′ 3 ″ 1 ⁄ 2. Optional when there is no fraction: 5 ′ 3 then + reads as 5′ 3″."
          }
        }
      }
    },
    "calc.help.key.fraction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraction bar. 1 ⁄ 2 is a half. Leave off the bottom and it uses the rounding setting: 15 ⁄ is 15/16."
          }
        }
      }
    },
    "calc.help.key.percent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percent. 137 sq ft + 10 % = 150.7 sq ft. 500 ′ × 18 % = 90′ 0″."
          }
        }
      }
    },
    "calc.help.key.equals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works it out exactly. The chip beside the answer shows how it was rounded; tap it to change."
          }
        }
      }
    },
    "calc.help.key.backspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes one character, through a fraction. On an answer, turns it back into a number you can edit."
          }
        }
      }
    },
    "calc.help.key.allClear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the expression. Undo brings it back."
          }
        }
      }
    },
    "calc.help.key.negate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flips the sign of the number you are typing, or of the answer."
          }
        }
      }
    },
    "calc.help.key.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parentheses group first: ( 2 ′ + 3 ″ ) × 4."
          }
        }
      }
    },
    "calc.help.key.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes a group. A missing close is filled in at =."
          }
        }
      }
    },
    "calc.help.key.pi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "π, for circles. π × 11 ″ is the circumference of an 11″ pipe."
          }
        }
      }
    },
    "calc.help.key.divide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 ′ 3 ″ ÷ 9 = 2′ 3″. A length divided by a length is a plain count: 30′ 4″ ÷ 7″ = 52."
          }
        }
      }
    },
    "calc.help.key.times": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A length times a length is an area: 5 ′ 3 ″ × 11 ′ 6 ″ 1 ⁄ 2 = 60.59 sq ft."
          }
        }
      }
    },
    "calc.help.key.plus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ′ 7 ″ 1 ⁄ 2 + 18 ′ 8 ″ = 24′ 3½″. A bare number here is inches."
          }
        }
      }
    },
    "calc.help.key.minus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11 ′ 7 ″ 1 ⁄ 2 − 3 ′ = 8′ 7½″."
          }
        }
      }
    },
    "calc.help.key.point": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decimals: 17 . 32 ′ = 17′ 3-13/16″."
          }
        }
      }
    },
    "calc.help.key.digit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digits. Type a measurement largest to smallest: feet, inches, fraction."
          }
        }
      }
    },
    "calc.help.field.rise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor to floor, finished to finished. 9 ′ 11 ″ gives 16 risers of 7-7/16″."
          }
        }
      }
    },
    "calc.help.field.run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. With 15 ′ 5 ″ the tread becomes 12-5/16″."
          }
        }
      }
    },
    "calc.help.field.riser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you would like each step to rise. Risers = rise ÷ this, rounded."
          }
        }
      }
    },
    "calc.help.field.tread": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tread depth when no run is given. Code minimum 10″."
          }
        }
      }
    },
    "calc.help.field.headroom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for the stairwell opening. Code minimum 6′ 8″."
          }
        }
      }
    },
    "calc.help.field.floorThickness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished floor to ceiling below, for the opening."
          }
        }
      }
    },
    "calc.help.field.riserLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a riser whenever the riser would exceed the limit."
          }
        }
      }
    },
    "calc.help.field.pitch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inches of rise per 12 of run: 7 for 7/12. Or degrees, or % grade."
          }
        }
      }
    },
    "calc.help.field.span": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building width; the run is half. 7/12 over 14′ 4″ gives a common rafter of 8′ 3-9/16″."
          }
        }
      }
    },
    "calc.help.field.spacing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafter or stud spacing on centre. 16″ is usual."
          }
        }
      }
    },
    "calc.help.field.waste": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order more than the plan says. NRMCA suggests 4–10 %."
          }
        }
      }
    },
    "calc.help.field.bag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "80 lb yields 0.60 cu ft, 60 lb 0.45, 50 lb 0.37, 40 lb 0.30. Bags round up."
          }
        }
      }
    },
    "calc.help.field.pricePerMbm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumber is priced per thousand board feet: 72 bd ft at $250 is $18.00."
          }
        }
      }
    },
    "calc.help.field.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A measurement. Type it as you read the tape."
          }
        }
      }
    },
